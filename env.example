# ─── TrendWear AI backend / deployment environment ─────────────────────────
# Copy to a private .env (never commit real values). These variables are read
# by the FastAPI backend (backend/app/core/database.py, services/*.py) and the
# ML/supabase scripts under ml/, scripts/, optimization/, risk_service/.

# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (optional — used for scenario/decision AI explanations)
GEMINI_API_KEY=

# Allowed CORS origin(s) for the frontend (space-separated is NOT supported;
# comma/JSON-list the origins in backend/app/main.py if you need >1).
# Use the production Vercel URL of the frontend.
FRONTEND_URL=https://trendwear-ai.vercel.app
